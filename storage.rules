rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Portadas de animes accesibles públicamente para lectura rápida
    match /covers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Regla general para cualquier otro archivo en Storage
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
